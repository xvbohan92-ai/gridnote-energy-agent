# demo: offline rules. openai: SQL. openai-tools / ollama-tools: adaptive tool loop.
ENERGY_PLANNER=demo
ENERGY_DB_PATH=data/energy.sqlite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Actual requests per tool-agent run; SDK retries are disabled in openai-tools.
ENERGY_MAX_MODEL_CALLS=3
# Local Ollama requires no cloud API key; only loopback addresses are accepted.
# Create the dedicated profile first: ollama create gridnote-qwen3:4b -f models/qwen3-gridnote.Modelfile
OLLAMA_MODEL=gridnote-qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Optional trained SQL component (requires the separate local training/serve_planner.py process).
# ENERGY_PLANNER=mlx-sql
MLX_BASE_URL=http://127.0.0.1:8768
MLX_MODEL_LABEL=Qwen3-4B QLoRA
# Optional USD / million token rates; unset means cost is unknown, not zero.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
